# Synthia™ White-Label Configuration Template
# Copy this file to .env.local and customize for your deployment
#
# Zero code changes needed — all configuration via environment variables.
# Deploy to any niche, country, or language with a single configuration file.

# ============================================================================
# BRAND IDENTITY
# ============================================================================

# Override Synthia™ brand name
# WL_BRAND_NAME=Synthia™ Colombia
WL_BRAND_NAME=

# Tagline in your language
# Spanish: "Tu IA. Tu datos. Tu negocio."
# English: "Your AI. Your data. Your business."
# Portuguese: "Sua IA. Seus dados. Seu negócio."
WL_TAGLINE=

# Logo URL (full path to image)
# Example: https://your-domain.com/logo.png
WL_LOGO_URL=

# Primary brand color (hex)
# Default: #c4963c (gold)
WL_PRIMARY_COLOR=

# Secondary brand color (hex)
# Default: #5a7a52 (sage green)
WL_SECONDARY_COLOR=

# Dark background color (hex)
# Default: #0a1108 (near-black)
WL_DARK_COLOR=

# ============================================================================
# LOCALIZATION & TARGETING
# ============================================================================

# Language preference (es, en, pt)
# Default: es
WL_LANGUAGE=es

# Target country/region code
# Examples: CO (Colombia), PE (Peru), MX (Mexico), BR (Brazil), ES (Spain)
# Default: LATAM
WL_COUNTRY=

# Timezone for the deployment
# Examples: America/Bogota, America/Lima, America/Mexico_City, America/Sao_Paulo
# Default: America/New_York
WL_TIMEZONE=

# ============================================================================
# NICHE / VERTICAL FOCUS
# ============================================================================

# Business vertical for templates and defaults
# Options: ecommerce, saas, agency, creator, corporate, nonprofit, education, health
# Default: general
WL_NICHE=

# Operator/team identifier
# Used in branding and audit trails
# Example: kupuri-media, acme-corp, startup-xyz
WL_OPERATOR_ID=

# ============================================================================
# PAYMENT & MONETIZATION (Creem.io)
# ============================================================================

# Creem.io API key for payment processing
# Get from: https://creem.io/settings/api
CREEM_API_KEY=

# Webhook secret for validating Creem.io events
# Get from: https://creem.io/settings/webhooks
CREEM_WEBHOOK_SECRET=

# Product IDs in Creem.io (copy from your products in Creem)
CREEM_STARTER_ID=
CREEM_PROFESSIONAL_ID=
CREEM_OPERATOR_ID=

# ============================================================================
# MEDIA GENERATION (muapi.ai)
# ============================================================================

# muapi.ai API key for unified media generation
# Get from: https://muapi.ai/account/api-keys
MUAPI_API_KEY=

# ============================================================================
# DATABASE & AUTHENTICATION
# ============================================================================

# Supabase project URL
# Get from: https://app.supabase.com/project/[PROJECT_ID]/settings/api
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon key (public, safe for browser)
# Get from: https://app.supabase.com/project/[PROJECT_ID]/settings/api
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ============================================================================
# EMAIL & NOTIFICATIONS
# ============================================================================

# Resend API key for transactional emails
# Get from: https://resend.com/api-keys
# OR use SendGrid instead
RESEND_API_KEY=

# SendGrid API key (alternative to Resend)
SENDGRID_API_KEY=

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable/disable Second Brain (personal knowledge graph)
# Default: true
WL_FEATURE_SECOND_BRAIN=true

# Enable/disable chat interface
# Default: true
WL_FEATURE_CHAT=true

# Enable/disable community portfolio
# Default: true
WL_FEATURE_PORTFOLIO=true

# Enable/disable media generation features
# Default: true
WL_FEATURE_MEDIA=true

# Enable/disable community features
# Default: true
WL_FEATURE_COMMUNITY=true

# Enable/disable BYOT (Bring Your Own Tools)
# Default: true
WL_FEATURE_BYOT=true

# ============================================================================
# BUILD & DEPLOYMENT
# ============================================================================

NODE_ENV=production

# Build ID for tracking
NEXT_PUBLIC_BUILD_ID=

# App version
NEXT_PUBLIC_APP_VERSION=1.0.0

# ============================================================================
# EXAMPLE CONFIGURATIONS FOR DIFFERENT REGIONS
# ============================================================================

# --- EXAMPLE 1: Colombia Ecommerce ---
# WL_BRAND_NAME=Synthia™ Colombia
# WL_TAGLINE=Tu IA para vender más en línea
# WL_COUNTRY=CO
# WL_LANGUAGE=es
# WL_NICHE=ecommerce
# WL_TIMEZONE=America/Bogota
# WL_OPERATOR_ID=colombia-ecommerce

# --- EXAMPLE 2: Peru Education ---
# WL_BRAND_NAME=Synthia™ Educación Perú
# WL_TAGLINE=Herramientas IA para docentes y estudiantes
# WL_COUNTRY=PE
# WL_LANGUAGE=es
# WL_NICHE=education
# WL_TIMEZONE=America/Lima
# WL_OPERATOR_ID=peru-education

# --- EXAMPLE 3: Brazil SaaS ---
# WL_BRAND_NAME=Synthia™ Brasil
# WL_TAGLINE=Sua IA soberana para empresas
# WL_COUNTRY=BR
# WL_LANGUAGE=pt
# WL_NICHE=saas
# WL_TIMEZONE=America/Sao_Paulo
# WL_OPERATOR_ID=brasil-saas

# --- EXAMPLE 4: Mexico Creators ---
# WL_BRAND_NAME=Synthia™ Creadores
# WL_TAGLINE=IA para influencers y creativos
# WL_COUNTRY=MX
# WL_LANGUAGE=es
# WL_NICHE=creator
# WL_TIMEZONE=America/Mexico_City
# WL_OPERATOR_ID=mexico-creators

# --- EXAMPLE 5: Spain Agency ---
# WL_BRAND_NAME=Synthia™ Studio
# WL_TAGLINE=Tu asistente IA para agencias de diseño
# WL_COUNTRY=ES
# WL_LANGUAGE=es
# WL_NICHE=agency
# WL_TIMEZONE=Europe/Madrid
# WL_OPERATOR_ID=spain-agency

# ============================================================================
# ADVANCED: CUSTOM INTEGRATIONS
# ============================================================================

# Your own analytics provider
ANALYTICS_API_KEY=

# Custom webhook for user events
WEBHOOK_USER_CREATED_URL=
WEBHOOK_PAYMENT_SUCCEEDED_URL=

# Content management system API
CMS_API_URL=
CMS_API_KEY=

# ============================================================================
# DEPLOYMENT NOTES
# ============================================================================

# 1. Copy this file: cp .env.whitelabel.example .env.local
# 2. Fill in required values (marked REQUIRED above)
# 3. For Creem.io: Create account at creem.io, get API key and webhook secret
# 4. For muapi.ai: Create account at muapi.ai, get API key
# 5. For Supabase: Create project at supabase.com, get URL and anon key
# 6. For email: Choose Resend or SendGrid, get API key
# 7. Deploy with: vercel deploy --prod (or your deployment platform)
# 8. Verify startup: npm run health-check
# 9. Test payment flow: Use Creem.io test mode
# 10. Publish pledge transparency: npm run publish-pledge-ledger
